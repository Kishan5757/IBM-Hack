# RepoPilot — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ── Primary AI provider: Gemini ───────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey  (free tier available)
# If this key is missing or Gemini fails for any reason, RepoPilot automatically
# falls back to the built-in rule-based engine — no extra setup needed.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Dev-only: force the rule engine even when Gemini is available ─────────────
# Set to "true" to bypass Gemini entirely and always use the offline engine.
# Useful for testing fallback behaviour without burning Gemini quota.
# NEVER set this to "true" in production.
FORCE_LOCAL_AI=false

# ── GitHub API token (STRONGLY RECOMMENDED) ──────────────────────────────────
# Without a token, GitHub allows only 60 API requests/hour per IP address.
# When that limit is hit, RepoPilot falls back to fetching files via
# raw.githubusercontent.com (no auth needed), but you will NOT get:
#   - the repository language detected by GitHub
#   - the description shown on the GitHub repo page
#   - the full file tree (only well-known filenames are probed)
#   - the star count
#
# To fix this:
#   1. Go to https://github.com/settings/tokens
#   2. Click "Generate new token (classic)"
#   3. Select scope: public_repo  (read-only public repos is enough)
#   4. Copy the token and paste it below
#
# With a token the limit increases to 5,000 requests/hour.
# Required for private repository access (add repo scope instead).
NEXT_PUBLIC_GITHUB_TOKEN=ghp_your_token_here
